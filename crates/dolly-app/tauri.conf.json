{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dolly",
  "version": "0.1.0",
  "identifier": "dev.dolly.editor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dolly",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/Dolly/**", "$VIDEO/Dolly/*"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
